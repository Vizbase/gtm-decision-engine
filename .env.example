# Database
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# Environment
APP_ENV=development

# Public portfolio mode
# Production should use true.
PUBLIC_PORTFOLIO_MODE=false

# Exact comma-separated browser origins.
# Add the final Vercel URL during deployment.
CORS_ORIGINS=http://localhost:3000

# Public demo limits
MAX_CSV_UPLOAD_BYTES=5242880
MAX_ANALYSIS_ACCOUNTS=200

# Live website enrichment limits
ENRICHMENT_TIMEOUT_SECONDS=8
MAX_ENRICHMENT_REDIRECTS=4
MAX_ENRICHMENT_RESPONSE_BYTES=2000000
